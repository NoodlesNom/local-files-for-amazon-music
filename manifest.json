{
  "manifest_version": 3,
  "name": "Amazon Music Local Files",
  "version": "1.0.0",
  "description": "Play audio files from this computer as a Local Files playlist anchored to an Amazon playlist named LOCAL PLACEHOLDER.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://music.amazon.com/*",
    "https://music.amazon.ca/*",
    "https://music.amazon.co.uk/*",
    "https://music.amazon.com.au/*",
    "https://music.amazon.in/*",
    "https://music.amazon.ae/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Amazon Music Local Files",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.amazon.com/*",
        "https://music.amazon.ca/*",
        "https://music.amazon.co.uk/*",
        "https://music.amazon.com.au/*",
        "https://music.amazon.in/*",
        "https://music.amazon.ae/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-files.js"
      ],
      "matches": [
        "https://music.amazon.com/*",
        "https://music.amazon.ca/*",
        "https://music.amazon.co.uk/*",
        "https://music.amazon.com.au/*",
        "https://music.amazon.in/*",
        "https://music.amazon.ae/*"
      ]
    }
  ]
}
